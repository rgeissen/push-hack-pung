+# livedevice for macOS: the same proxy, as a VST3 bundle Live on a Mac loads
+# (Pung, docs/PUNG-MACOS.md). Built with Makefiles and Apple's command line
+# tools; no Xcode.
+cmake_minimum_required(VERSION 3.25)
+set(CMAKE_OSX_DEPLOYMENT_TARGET "14.4" CACHE STRING "")   # os_sync_wait_on_address
+set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "")
+project(LiveDevice VERSION 0.1.0 LANGUAGES C CXX OBJC OBJCXX)
+set(CMAKE_CXX_STANDARD 17)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+set(SMTG_ENABLE_VST3_PLUGIN_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(SMTG_ENABLE_VST3_HOSTING_EXAMPLES OFF CACHE BOOL "" FORCE)
+set(SMTG_ENABLE_VSTGUI_SUPPORT OFF CACHE BOOL "" FORCE)
+set(SMTG_CREATE_PLUGIN_LINK OFF CACHE BOOL "" FORCE)
+set(SMTG_RUN_VST_VALIDATOR OFF CACHE BOOL "" FORCE)
+set(SMTG_CREATE_MODULE_INFO OFF CACHE BOOL "" FORCE)
+set(SMTG_ENABLE_AUV2_BUILDS OFF CACHE BOOL "" FORCE)
+set(SMTG_DISABLE_CODE_SIGNING ON CACHE BOOL "" FORCE)
+set(VST3SDK "" CACHE PATH "the VST3 SDK")
+add_subdirectory(${VST3SDK} ${PROJECT_BINARY_DIR}/vst3sdk)
+smtg_enable_vst3_sdk()
+smtg_add_vst3plugin(livedevice source/proxy.cpp source/params.cpp)
+target_link_libraries(livedevice PRIVATE sdk)
+
+# playtest: hosts a bundle like Live and checks real sound through its hack
+add_executable(playtest test/playtest.cpp
+    ${VST3SDK}/public.sdk/source/vst/hosting/module.cpp
+    ${VST3SDK}/public.sdk/source/vst/hosting/module_mac.mm
+    ${VST3SDK}/public.sdk/source/vst/hosting/plugprovider.cpp
+    ${VST3SDK}/public.sdk/source/vst/hosting/connectionproxy.cpp
+    ${VST3SDK}/public.sdk/source/vst/moduleinfo/moduleinfoparser.cpp
+    ${VST3SDK}/public.sdk/source/common/memorystream.cpp)
+set_source_files_properties(${VST3SDK}/public.sdk/source/vst/hosting/module_mac.mm PROPERTIES COMPILE_FLAGS "-fobjc-arc")
+target_link_libraries(playtest PRIVATE sdk_hosting "-framework Cocoa")
