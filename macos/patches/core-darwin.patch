+// viewtest: opens a device's window the way a host does and takes a picture
+// of it (macOS). A validator cannot tell a window that shows the hack's page
+// from an empty one; this can.
+//
+//   viewtest <Bundle.vst3> "<class name>" <out.png> [seconds]
+#include "public.sdk/source/vst/hosting/hostclasses.h"
+#include "public.sdk/source/vst/hosting/module.h"
+#include "public.sdk/source/vst/hosting/plugprovider.h"
+#include "pluginterfaces/gui/iplugview.h"
+#include "pluginterfaces/vst/ivstaudioprocessor.h"
+#include "pluginterfaces/vst/ivstcomponent.h"
+#include "pluginterfaces/vst/ivsteditcontroller.h"
+
+#import <Cocoa/Cocoa.h>
+#import <WebKit/WebKit.h>
+#include <cstdio>
+#include <string>
+
+using namespace Steinberg;
+using namespace Steinberg::Vst;
+
+static WKWebView* findWeb(NSView* v) {
+    if ([v isKindOfClass:[WKWebView class]]) return (WKWebView*)v;
+    for (NSView* s in v.subviews)
+        if (WKWebView* w = findWeb(s)) return w;
+    return nil;
+}
+
+int main(int argc, char** argv) {
+    if (argc < 4) { std::fprintf(stderr, "usage: %s <Bundle.vst3> <class name> <out.png> [seconds]\n", argv[0]); return 2; }
+    double seconds = argc > 4 ? std::atof(argv[4]) : 6;
+    @autoreleasepool {
+        [NSApplication sharedApplication];
+        [NSApp setActivationPolicy:NSApplicationActivationPolicyAccessory];
+        std::string err;
+        auto module = VST3::Hosting::Module::create(argv[1], err);
+        if (!module) { std::fprintf(stderr, "load: %s\n", err.c_str()); return 1; }
+        PluginContextFactory::instance().setPluginContext(new HostApplication());
+        VST3::Hosting::ClassInfo found;
+        bool ok = false;
+        for (auto& ci : module->getFactory().classInfos())
+            if (ci.category() == kVstAudioEffectClass && ci.name() == argv[2]) { found = ci; ok = true; }
+        if (!ok) { std::fprintf(stderr, "no class %s\n", argv[2]); return 1; }
+        IPtr<PlugProvider> provider = owned(new PlugProvider(module->getFactory(), found, true));
+        if (!provider->initialize()) { std::fprintf(stderr, "initialize failed\n"); return 1; }
+        IPtr<IComponent> component = owned(provider->getComponent());
+        IPtr<IEditController> controller = owned(provider->getController());
+        component->setActive(true);
+        // the plugin reaches its service on a thread of its own: the device is made a moment later
+        [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:2.0]];
+        IPtr<IPlugView> view = owned(controller->createView(ViewType::kEditor));
+        if (!view) { std::printf("%s: no window\n", argv[2]); return 3; }
+        ViewRect r;
+        view->getSize(&r);
+        NSWindow* win = [[NSWindow alloc] initWithContentRect:NSMakeRect(80, 80, r.getWidth(), r.getHeight())
+                                                    styleMask:NSWindowStyleMaskTitled backing:NSBackingStoreBuffered defer:NO];
+        [win orderBack:nil];
+        if (view->attached((__bridge void*)win.contentView, kPlatformTypeNSView) != kResultTrue) { std::printf("attach failed\n"); return 4; }
+        [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:seconds]];
+        WKWebView* web = findWeb(win.contentView);
+        if (!web) { std::printf("%s: a window, but no web view in it\n", argv[2]); return 5; }
+        __block bool done = false;
+        __block int rc = 6;
+        NSString* out = [NSString stringWithUTF8String:argv[3]];
+        std::printf("%s: window %d x %d, showing %s\n", argv[2], r.getWidth(), r.getHeight(), web.URL.absoluteString.UTF8String ?: "(nothing)");
+        [web evaluateJavaScript:@"JSON.stringify({title: document.title, embed: document.documentElement.classList.contains('embed'), unit: (document.querySelector('#panel-title')||{}).textContent || '', bar: !!(document.querySelector('.bar') && document.querySelector('.bar').offsetParent), text: document.body.innerText.slice(0, 160)})"
+              completionHandler:^(id res, NSError* e) { std::printf("page: %s\n", res ? [[res description] UTF8String] : (e ? e.localizedDescription.UTF8String : "?")); }];
+        [web takeSnapshotWithConfiguration:nil completionHandler:^(NSImage* img, NSError* e) {
+            if (img) {
+                NSBitmapImageRep* rep = [[NSBitmapImageRep alloc] initWithData:[img TIFFRepresentation]];
+                [[rep representationUsingType:NSBitmapImageFileTypePNG properties:@{}] writeToFile:out atomically:YES];
+                rc = 0;
+            } else if (e) {
+                std::printf("no picture: %s\n", e.localizedDescription.UTF8String);
+            }
+            done = true;
+        }];
+        for (int i = 0; i < 100 && !done; i++) [[NSRunLoop currentRunLoop] runUntilDate:[NSDate dateWithTimeIntervalSinceNow:0.1]];
+        view->removed();
+        component->setActive(false);
+        return rc;
+    }
+}
