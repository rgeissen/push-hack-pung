diff -ruN -x .macbuild -x .sdk -x *.so a/core/livedevice/sys_darwin.go core/livedevice/sys_darwin.go
--- a/core/livedevice/sys_darwin.go	1970-01-01 01:00:00
+++ b/core/livedevice/sys_darwin.go	2026-11-28 01:48:24
@@ -0,0 +1,97 @@
+//go:build darwin
+
+package livedevice
+
+/*
+#include <errno.h>
+#include <fcntl.h>
+#include <mach/mach.h>
+#include <mach/mach_time.h>
+#include <mach/thread_policy.h>
+#include <os/os_sync_wait_on_address.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+// A device's shared memory on macOS: a POSIX shared memory object (memory only,
+// no file behind it). The plugin opens it by the same name.
+static void* ld_shm_create(const char* name, size_t size) {
+	shm_unlink(name);
+	int fd = shm_open(name, O_RDWR | O_CREAT | O_EXCL, 0600);
+	if (fd < 0) return NULL;
+	if (ftruncate(fd, (off_t)size) != 0) { close(fd); shm_unlink(name); return NULL; }
+	void* p = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	close(fd);
+	if (p == MAP_FAILED) { shm_unlink(name); return NULL; }
+	return p;
+}
+static void ld_shm_free(void* p, size_t size, const char* name) { munmap(p, size); shm_unlink(name); }
+
+// The wake word: sleep while *addr == val, at most ns. Shared: the plugin is
+// another process (macOS 14.4 and later).
+static void ld_wait(uint32_t* addr, uint32_t val, uint64_t ns) {
+	os_sync_wait_on_address_with_timeout(addr, val, 4, OS_SYNC_WAIT_ON_ADDRESS_SHARED, OS_CLOCK_MACH_ABSOLUTE_TIME, ns);
+}
+static void ld_wake(uint32_t* addr) { os_sync_wake_by_address_all(addr, 4, OS_SYNC_WAKE_BY_ADDRESS_SHARED); }
+
+// A realtime thread on macOS: a time-constraint policy (there is no SCHED_FIFO
+// for an ordinary program). The numbers are for a 128-frame block at 44.1 kHz:
+// every 2.9 ms, at most 1.5 ms of work, done within the period.
+static int ld_realtime(void) {
+	mach_timebase_info_data_t tb;
+	mach_timebase_info(&tb);
+	double ticks_per_ms = 1e6 * (double)tb.denom / (double)tb.numer;
+	thread_time_constraint_policy_data_t pol;
+	pol.period = (uint32_t)(2.9 * ticks_per_ms);
+	pol.computation = (uint32_t)(1.5 * ticks_per_ms);
+	pol.constraint = (uint32_t)(2.9 * ticks_per_ms);
+	pol.preemptible = 1;
+	return thread_policy_set(pthread_mach_thread_np(pthread_self()), THREAD_TIME_CONSTRAINT_POLICY,
+		(thread_policy_t)&pol, THREAD_TIME_CONSTRAINT_POLICY_COUNT) == KERN_SUCCESS;
+}
+*/
+import "C"
+
+import (
+	"errors"
+	"fmt"
+	"time"
+	"unsafe"
+)
+
+// shmPath: a device's shared memory, a POSIX name (at most 31 letters on
+// macOS, so the name is kept short: the id is unique by itself).
+func shmPath(name string, id int) string {
+	if len(name) > 12 {
+		name = name[:12]
+	}
+	return fmt.Sprintf("/%s-%d", name, id)
+}
+
+func shmCreate(path string, size int) ([]byte, error) {
+	cs := C.CString(path)
+	defer C.free(unsafe.Pointer(cs))
+	p := C.ld_shm_create(cs, C.size_t(size))
+	if p == nil {
+		return nil, errors.New("livedevice: no shared memory " + path)
+	}
+	return unsafe.Slice((*byte)(p), size), nil
+}
+
+func shmFree(mem []byte, path string) {
+	cs := C.CString(path)
+	defer C.free(unsafe.Pointer(cs))
+	C.ld_shm_free(unsafe.Pointer(&mem[0]), C.size_t(len(mem)), cs)
+}
+
+func futexWait(addr *uint32, val uint32, d time.Duration) {
+	C.ld_wait((*C.uint32_t)(unsafe.Pointer(addr)), C.uint32_t(val), C.uint64_t(d.Nanoseconds()))
+}
+
+func futexWake(addr *uint32) { C.ld_wake((*C.uint32_t)(unsafe.Pointer(addr))) }
+
+// setRealtime: the calling thread becomes a realtime one (the priority is
+// Linux's and means nothing here).
+func setRealtime(priority int) { C.ld_realtime() }
