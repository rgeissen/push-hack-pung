@@ -0,0 +1,59 @@
+// editor_mac.mm: a device's window on macOS: the hack's own page for that
+// device, in a web view. The page is the hack's (Pung serves its interface on
+// this machine); the plugin only gives it a place in the host's window.
+#include "public.sdk/source/common/pluginview.h"
+
+#import <Cocoa/Cocoa.h>
+#import <WebKit/WebKit.h>
+#include <string>
+
+using namespace Steinberg;
+
+namespace {
+
+class WebEditor : public CPluginView {
+public:
+    explicit WebEditor(std::string url) : url_(std::move(url)) {
+        ViewRect r(0, 0, 1040, 700);
+        setRect(r);
+    }
+    tresult PLUGIN_API isPlatformTypeSupported(FIDString type) override {
+        return type && strcmp(type, kPlatformTypeNSView) == 0 ? kResultTrue : kResultFalse;
+    }
+    tresult PLUGIN_API attached(void* parent, FIDString type) override {
+        if (isPlatformTypeSupported(type) != kResultTrue) return kResultFalse;
+        NSView* p = (__bridge NSView*)parent;
+        web_ = [[WKWebView alloc] initWithFrame:p.bounds configuration:[[WKWebViewConfiguration alloc] init]];
+        web_.autoresizingMask = NSViewWidthSizable | NSViewHeightSizable;
+        [p addSubview:web_];
+        NSURL* u = [NSURL URLWithString:[NSString stringWithUTF8String:url_.c_str()]];
+        if (u) [web_ loadRequest:[NSURLRequest requestWithURL:u cachePolicy:NSURLRequestReloadIgnoringLocalCacheData timeoutInterval:10]];
+        return CPluginView::attached(parent, type);
+    }
+    tresult PLUGIN_API removed() override {
+        [web_ removeFromSuperview];
+        web_ = nil;
+        return CPluginView::removed();
+    }
+    tresult PLUGIN_API canResize() override { return kResultTrue; }
+    tresult PLUGIN_API onSize(ViewRect* r) override {
+        if (!r) return kInvalidArgument;
+        setRect(*r);
+        if (web_) [web_ setFrame:NSMakeRect(0, 0, r->getWidth(), r->getHeight())];
+        return kResultTrue;
+    }
+    tresult PLUGIN_API checkSizeConstraint(ViewRect* r) override {
+        if (!r) return kInvalidArgument;
+        if (r->getWidth() < 640) r->right = r->left + 640;
+        if (r->getHeight() < 400) r->bottom = r->top + 400;
+        return kResultTrue;
+    }
+
+private:
+    std::string url_;
+    WKWebView* web_ = nil;
+};
+
+} // namespace
+
+Steinberg::IPlugView* ldMakeView(const std::string& url) { return new WebEditor(url); }
